# Logitech Brio 100 - capture node only (stable symlink)
# Removed systemd hook to avoid FOURCC conflict with camera_pub.cpp
SUBSYSTEM=="video4linux", KERNEL=="video[0-9]*", \
  ATTRS{idVendor}=="046d", ATTRS{idProduct}=="094c", \
  ATTRS{product}=="Brio 100", ATTRS{serial}=="2538ZBG1R588", \
  ATTR{index}=="0", \
  SYMLINK+="video/brio100", GROUP="video", MODE="0660"
